# =====================================================================
# Örnek ortam değişkenleri. Gerçek değerler:
#   - Mac:      .env.local (Git'e girmez; yalnız GELİŞTİRME değerleri)
#   - Sunucu:   Coolify ortam değişkenleri (development ve production ayrı)
# Production sırları Mac'e indirilmez.
# =====================================================================

# --- Faz 1 (zorunlu) ---------------------------------------------------
# local | development | test | production
APP_ENV=local
# Marka adı koda gömülmez
APP_NAME=Kiralığım
# Ev sahibi paneli, admin paneli ve public sayfalar: üç ayrı host
APP_URL=http://app.localhost:3000
ADMIN_URL=http://admin.localhost:3000
PUBLIC_URL=http://localhost:3000
# Uygulama bağlantısı (app_user). Veritabanı adı ortamla eşleşmeli:
# local/development → *_dev, production → *_prod, test → *_test
DATABASE_URL=postgres://app_user:PAROLA@localhost:5433/lodging_dev
# Yalnız migration adımı (app_migrator)
MIGRATION_DATABASE_URL=postgres://app_migrator:PAROLA@localhost:5433/lodging_dev
# debug | info | warn | error (boşsa: production'da info, diğerlerinde debug)
LOG_LEVEL=
# Uygulama DB rolü güvensizse (süper kullanıcı, BYPASSRLS, tablo sahibi...):
# warn → yalnız log, enforce → /api/health 503. Production'da kurulum bitince enforce.
DB_ROLE_GUARD=warn
# Yalnız konteyner: true ise açılışta önce migration (scripts/docker-entrypoint.sh)
RUN_MIGRATIONS_ON_START=false

# --- SSH tüneli (yalnız Mac, npm run db:tunnel) ------------------------
# Sunucuya SSH ile bağlanılan kullanıcı@adres; anahtarınız ~/.ssh altında olmalı
DB_TUNNEL_SSH=kullanici@sunucu-adresi
DB_TUNNEL_LOCAL_PORT=5433
DB_TUNNEL_REMOTE_PORT=55432

# --- Faz 2 --------------------------------------------------------------
DATABASE_ADMIN_URL=
DATABASE_WORKER_URL=
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# openssl rand -base64 32  (kaybolursa şifreli veriler açılamaz; ayrıca güvenli yedek alın)
ENCRYPTION_KEK_V1=
RESEND_API_KEY=
EMAIL_FROM=

# --- Faz 3 --------------------------------------------------------------
# Virgülle ayrılmış IP listesi; boşsa kısıt yok
ADMIN_IP_ALLOWLIST=

# --- Faz 5 (Cloudflare R2) ----------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Faz 14 (WhatsApp Cloud API) ----------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
