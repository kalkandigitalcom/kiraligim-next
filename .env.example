# =====================================================================
# Örnek ortam değişkenleri. Gerçek değerler:
#   - Mac:      .env.local (Git'e girmez; yalnız GELİŞTİRME değerleri)
#   - Sunucu:   Coolify ortam değişkenleri (development ve production ayrı)
# Production sırları Mac'e indirilmez.
# =====================================================================

# --- Faz 1 (zorunlu) ---------------------------------------------------
# local | development | test | production
APP_ENV=local
# Marka adı koda gömülmez
APP_NAME=Kiralığım
# Ev sahibi paneli, admin paneli ve public sayfalar: üç ayrı host
APP_URL=http://app.localhost:3000
ADMIN_URL=http://admin.localhost:3000
PUBLIC_URL=http://localhost:3000
# Uygulama bağlantısı (app_user). Veritabanı adı ortamla eşleşmeli:
# local/development → *_dev, production → *_prod, test → *_test
DATABASE_URL=postgres://app_user:PAROLA@localhost:5433/lodging_dev
# Yalnız migration adımı (app_migrator)
MIGRATION_DATABASE_URL=postgres://app_migrator:PAROLA@localhost:5433/lodging_dev
# debug | info | warn | error (boşsa: production'da info, diğerlerinde debug)
LOG_LEVEL=
# Uygulama DB rolü güvensizse (süper kullanıcı, BYPASSRLS, tablo sahibi...):
# warn → yalnız log, enforce → /api/health 503. Production'da kurulum bitince enforce.
DB_ROLE_GUARD=warn
# Yalnız konteyner: true ise açılışta önce migration (scripts/docker-entrypoint.sh)
RUN_MIGRATIONS_ON_START=false

# --- SSH tüneli (yalnız Mac, npm run db:tunnel) ------------------------
# Sunucuya SSH ile bağlanılan kullanıcı@adres; anahtarınız ~/.ssh altında olmalı
DB_TUNNEL_SSH=kullanici@sunucu-adresi
DB_TUNNEL_LOCAL_PORT=5433
DB_TUNNEL_REMOTE_PORT=55432

# --- Kimlik (ev sahibi, Better Auth) – src/server/auth/env.ts -----------
# Yalnız kimlik sistemi kullanıldığında doğrulanır. Better Auth adresi APP_URL'dir
# (BETTER_AUTH_URL kullanılmaz), uç nokta APP_URL/api/auth.
# openssl rand -base64 32  → ortam başına farklı; değişirse tüm oturumlar düşer
BETTER_AUTH_SECRET=
# Public kayıt. Onboarding ve KVKK onayı hazır olana kadar false (Aşama 2.6)
AUTH_SIGNUP_ENABLED=false
# Deneme sınırı için istemci IP başlığı. Cloudflare proxy'si açık ve sunucuya yalnız
# Cloudflare erişebiliyorsa: cf-connecting-ip. Aksi halde x-forwarded-for + AUTH_TRUSTED_PROXIES.
AUTH_IP_HEADER=x-forwarded-for
# Güvenilen vekil IP/CIDR listesi (virgülle). x-forwarded-for zinciri sağdan bu adresler atlanarak okunur.
AUTH_TRUSTED_PROXIES=

# --- E-posta – src/lib/email ---------------------------------------------
# resend | log | memory. Boşsa: local → log (gönderilmez, log'a yazılır), test → memory.
# development ve production'da açıkça resend yazılmalı; production'da başka değer kabul edilmez.
EMAIL_TRANSPORT=
# Resend: re_ ile başlar; yalnız e-posta gönderme yetkili, alan adına kısıtlı anahtar kullanın
RESEND_API_KEY=
# Resend'de doğrulanmış alan adından: Kiralığım <bildirim@kiraligim.com>
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Faz 2 (sonraki aşamalar) -------------------------------------------
DATABASE_ADMIN_URL=
DATABASE_WORKER_URL=
# openssl rand -base64 32  (kaybolursa şifreli veriler açılamaz; ayrıca güvenli yedek alın)
ENCRYPTION_KEK_V1=

# --- Faz 3 --------------------------------------------------------------
# Virgülle ayrılmış IP listesi; boşsa kısıt yok
ADMIN_IP_ALLOWLIST=

# --- Fotoğraf depolama (Aşama 2.4c) – src/server/storage/env.ts ----------
# r2 | filesystem | memory. Boşsa: production/development → r2, local → filesystem, test → memory.
# production ve development YALNIZ r2 kullanabilir. Yapılandırma eksikse uygulama açılır ama
# fotoğraf yükleme "yapılandırılmadı" (503) döner. Denetim: npm run storage:check
STORAGE_DRIVER=
# Yalnız filesystem (yerel geliştirme): fotoğrafların yazılacağı dizin; Git'e girmez
STORAGE_LOCAL_DIR=.storage
# Cloudflare R2. Belirteç: yalnız ilgili bucket için "Object Read & Write" (hesap geneli değil).
# Hesap kimliği: 32 karakter hex (Cloudflare panelinde R2 → Account ID)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# production → kiraligim-media-prod, development / Mac → kiraligim-media-dev (sonek zorunlu)
R2_BUCKET=
# Bucket'a bağlı özel alan adı (yalnız kök, https): production → https://img.kiraligim.com,
# development → https://img-dev.kiraligim.com. CSP img-src'ye otomatik eklenir.
R2_PUBLIC_BASE_URL=

# --- Faz 14 (WhatsApp Cloud API) ----------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
