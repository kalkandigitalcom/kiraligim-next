# Bu dosyayı .env olarak kopyalayın (.env Git'e girmez).

# ZORUNLU: bağlanmasına izin verilen TEK numara (ülke koduyla, yalnız rakam; ör. 905xxxxxxxxx).
# Başka bir hesap QR'ı okutursa oturum hemen kapatılır ve anahtarlar silinir.
# (Faz 1'deki WA_TEST_NUMBER adı da kabul edilir.)
WA_ALLOWED_NUMBER=

# Ortam: development (varsayılan) ya da production (sunucu).
#   development: veritabanı adı "_dev" ile bitmeli, "prod" içermemeli; rol app_wa_gateway veya app_user.
#   production : veritabanı adı "_prod" ile bitmeli; rol YALNIZ app_wa_gateway (scripts/wa-gateway-role.sql).
WA_ENV=development

# A1: Kiraligim veritabanı. Boşsa Faz 1 test biçimi çalışır (yalnız Mac'te; WA_REQUIRE_DATABASE=false).
# Ad ve rol bağlantıdan önce/hemen sonra denetlenir; uymazsa servis başlamaz.
# Ör. Mac'te tünelle: postgres://app_user:<parola>@127.0.0.1:<yerel-port>/<geliştirme-veritabanı>
WA_DATABASE_URL=

# true: WA_DATABASE_URL yoksa servis başlamaz (Faz 1 test biçimine düşmez). Konteyner imajında true;
# WA_ENV=production'da her zaman zorunlu.
WA_REQUIRE_DATABASE=false

# A1: bu ağ geçidinin bağlantı etiketi (küçük harf, rakam, - _).
WA_CONNECTION_LABEL=primary

# Faz 1 (yalnız WA_DATABASE_URL boşken): tepki bırakılacak test grubunun kimliği (ör. 1203630xxxxxxxxx@g.us).
# Boşsa hiçbir mesaja tepki bırakılmaz; test arayüzü gelen mesajların grup kimliğini gösterir.
WA_TEST_GROUP_JID=

# Faz 1 test grubu tepki emojisi (A1 yalnız başarılı grup bağlamada sabit ✅ bırakır).
WA_TEST_REACTION=✅

# Test arayüzü adresi: 127.0.0.1 (Mac) ya da konteyner içinde 0.0.0.0. Konteynerde dışarıya yalnız
# sunucunun 127.0.0.1:4010 port eşlemesiyle açılır; erişim SSH tüneliyle. Host başlığı denetimi sürer.
WA_HTTP_HOST=127.0.0.1
WA_HTTP_PORT=4010

# Oturum anahtarlarının klasörü (Git'e girmez, yalnız sahibine okunur). Yalnız servis klasöründeki
# ".wa-auth" veya ".wa-auth-<etiket>" kabul edilir; başka yol ya da sembolik bağlantıyla servis başlamaz.
WA_AUTH_DIR=.wa-auth
