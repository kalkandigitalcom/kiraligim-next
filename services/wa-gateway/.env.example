# Bu dosyayı .env olarak kopyalayın (.env Git'e girmez).

# ZORUNLU: bağlanmasına izin verilen TEK numara (ülke koduyla, yalnız rakam; ör. 905xxxxxxxxx).
# Başka bir hesap QR'ı okutursa oturum hemen kapatılır ve anahtarlar silinir.
# (Faz 1'deki WA_TEST_NUMBER adı da kabul edilir.)
WA_ALLOWED_NUMBER=

# A1: Kiraligim GELİŞTİRME veritabanı (app_user). Boşsa Faz 1 test biçimi çalışır (veritabanı yok).
# Veritabanı adı "_dev" ile bitmeli ve "prod" içermemeli (bağlantıdan önce denetlenir).
# Production veritabanını ASLA yazmayın.
# Ör. tünelle: postgres://app_user:<parola>@127.0.0.1:<yerel-port>/<geliştirme-veritabanı>
WA_DATABASE_URL=

# A1: bu ağ geçidinin bağlantı etiketi (küçük harf, rakam, - _).
WA_CONNECTION_LABEL=primary

# Faz 1 (yalnız WA_DATABASE_URL boşken): tepki bırakılacak test grubunun kimliği (ör. 1203630xxxxxxxxx@g.us).
# Boşsa hiçbir mesaja tepki bırakılmaz; test arayüzü gelen mesajların grup kimliğini gösterir.
WA_TEST_GROUP_JID=

# Faz 1 test grubu tepki emojisi (A1 yalnız başarılı grup bağlamada sabit ✅ bırakır).
WA_TEST_REACTION=✅

# Test arayüzü yalnız bu bilgisayardan açılır.
WA_HTTP_PORT=4010

# Oturum anahtarlarının klasörü (Git'e girmez, yalnız sahibine okunur). Yalnız servis klasöründeki
# ".wa-auth" veya ".wa-auth-<etiket>" kabul edilir; başka yol ya da sembolik bağlantıyla servis başlamaz.
WA_AUTH_DIR=.wa-auth
