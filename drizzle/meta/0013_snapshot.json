          "value": "case when \"properties\".\"pool_swimming\" then \"properties\".\"pool_swimming_depth\" is not null and \"properties\".\"pool_swimming_width\" is not null and \"properties\".\"pool_swimming_length\" is not null and \"properties\".\"pool_swimming_depth\" between 0.1 and 10 and \"properties\".\"pool_swimming_width\" between 0.5 and 100 and \"properties\".\"pool_swimming_length\" between 0.5 and 100 else \"properties\".\"pool_swimming_depth\" is null and \"properties\".\"pool_swimming_width\" is null and \"properties\".\"pool_swimming_length\" is null end"
        },
        "properties_pool_indoor": {
          "name": "properties_pool_indoor",
          "value": "case when \"properties\".\"pool_indoor\" then \"properties\".\"pool_indoor_depth\" is not null and \"properties\".\"pool_indoor_width\" is not null and \"properties\".\"pool_indoor_length\" is not null and \"properties\".\"pool_indoor_depth\" between 0.1 and 10 and \"properties\".\"pool_indoor_width\" between 0.5 and 100 and \"properties\".\"pool_indoor_length\" between 0.5 and 100 else \"properties\".\"pool_indoor_depth\" is null and \"properties\".\"pool_indoor_width\" is null and \"properties\".\"pool_indoor_length\" is null end"
        },
        "properties_pool_kids": {
          "name": "properties_pool_kids",
          "value": "case when \"properties\".\"pool_kids\" then \"properties\".\"pool_kids_depth\" is not null and \"properties\".\"pool_kids_width\" is not null and \"properties\".\"pool_kids_length\" is not null and \"properties\".\"pool_kids_depth\" between 0.1 and 10 and \"properties\".\"pool_kids_width\" between 0.5 and 100 and \"properties\".\"pool_kids_length\" between 0.5 and 100 else \"properties\".\"pool_kids_depth\" is null and \"properties\".\"pool_kids_width\" is null and \"properties\".\"pool_kids_length\" is null end"
        },
